<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncvault.server.controller.ServerController"
            prefWidth="1020.0" prefHeight="680.0"
            stylesheets="@../../css/style.css">

    <!-- Thanh tiêu đề điều hành cấp cao -->
    <top>
        <VBox>
            <HBox styleClass="hud-bar" spacing="16" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="10" right="16" bottom="10" left="16"/>
                </padding>
                <Label text="SYNCVAULT // TRUNG TÂM ĐIỀU HÀNH MÁY CHỦ" styleClass="hud-title"/>
                <Label fx:id="serverRoleLabel" text="[ SERVER A // PRIMARY ]" styleClass="telemetry-value-cyan"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Trạng thái:" styleClass="telemetry-label"/>
                <Label fx:id="statusPillLabel" text="TRỰC TUYẾN" styleClass="server-status-pill-running"/>

                <Label text="CSDL:" styleClass="telemetry-label"/>
                <Label fx:id="dbStatusLabel" text="MYSQL" styleClass="telemetry-value-nominal"/>

                <Label text="Đối tác:" styleClass="telemetry-label"/>
                <Label fx:id="peerStatusLabel" text="CHỜ KẾT NỐI" styleClass="telemetry-value-warn"/>

                <Button fx:id="serverToggleBtn" text="⏹ DỪNG MÁY CHỦ" onAction="#handleToggleServer"
                        styleClass="button-danger" prefWidth="160.0"/>
            </HBox>

            <!-- Thanh thông số viễn trắc mạng và cấu hình -->
            <HBox styleClass="terminal-panel" spacing="20" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="10" right="16" bottom="10" left="16"/>
                </padding>

                <!-- Địa chỉ IP LAN -->
                <VBox spacing="3">
                    <Label text="ĐỊA CHỈ IP LAN MÁY CHỦ:" styleClass="telemetry-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="ipDisplayLabel" text="127.0.0.1" styleClass="telemetry-value-nominal"/>
                        <Button text="📋 SAO CHÉP IP" onAction="#handleCopyIp" styleClass="button"/>
                    </HBox>
                </VBox>

                <!-- Cổng FTP -->
                <VBox spacing="3">
                    <Label text="CỔNG FTP:" styleClass="telemetry-label"/>
                    <TextField fx:id="ftpPortField" text="2121" prefWidth="80.0"/>
                </VBox>

                <!-- Cổng RMI -->
                <VBox spacing="3">
                    <Label text="CỔNG RMI:" styleClass="telemetry-label"/>
                    <TextField fx:id="rmiPortField" text="1099" prefWidth="80.0"/>
                </VBox>

                <!-- Server đối tác -->
                <VBox spacing="3">
                    <Label text="ĐỊA CHỈ SERVER ĐỐI TÁC:" styleClass="telemetry-label"/>
                    <TextField fx:id="peerHostField" text="127.0.0.1" prefWidth="130.0"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Nút mở thư mục lưu trữ -->
                <VBox spacing="3" alignment="CENTER_RIGHT">
                    <Label text="KHO LƯU TRỮ TỆP TIN:" styleClass="telemetry-label"/>
                    <Button fx:id="openStorageBtn" text="📁 MỞ THƯ MỤC STORAGE" onAction="#handleOpenStorage"
                            styleClass="button-action"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Khung giám sát phân tách 2 cột -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <SplitPane fx:id="monitorSplitPane" dividerPositions="0.44" VBox.vgrow="ALWAYS">
                <!-- Cột trái: Quản lý phiên đăng nhập độc quyền -->
                <VBox styleClass="terminal-panel" spacing="8">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="[ PHIÊN ĐĂNG NHẬP ĐANG HOẠT ĐỘNG ]" styleClass="panel-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="sessionCountLabel" text="0 PHIÊN" styleClass="telemetry-value-nominal"/>
                    </HBox>
                    <Label text="Quy tắc: 1 tài khoản chỉ được phép online tại 1 máy chủ duy nhất"
                           styleClass="telemetry-label" style="-fx-font-size: 11px; -fx-text-fill: #706b5d;"/>

                    <TableView fx:id="sessionsTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUsername" text="TÀI KHOẢN" prefWidth="120.0"/>
                            <TableColumn fx:id="colClientIp" text="IP MÁY KHÁCH" prefWidth="130.0"/>
                            <TableColumn fx:id="colLoginTime" text="THỜI GIAN ĐĂNG NHẬP" prefWidth="140.0"/>
                            <TableColumn fx:id="colServerId" text="MÁY CHỦ" prefWidth="90.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Button text="LÀM MỚI" onAction="#handleRefreshSessions" styleClass="button"/>
                        <Button text="NGẮT KẾT NỐI PHIÊN ĐÃ CHỌN" onAction="#handleDisconnectSession"
                                styleClass="button-danger"/>
                    </HBox>
                </VBox>

                <!-- Cột phải: Nhật ký thời gian thực (Live Log Terminal) -->
                <VBox styleClass="terminal-panel" spacing="8">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="[ NHẬT KÝ ĐỒNG BỘ PHÂN TÁN &amp; LỆNH FTP ]" styleClass="panel-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="XÓA NHẬT KÝ" onAction="#handleClearLog" styleClass="button"/>
                    </HBox>

                    <TextArea fx:id="logTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                              styleClass="server-log-area"/>
                </VBox>
            </SplitPane>
        </VBox>
    </center>

    <!-- Thanh trạng thái chân trang -->
    <bottom>
        <HBox styleClass="hud-status-bar" spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <Label fx:id="footerSessionsLabel" text="Máy khách: 0 trực tuyến" styleClass="telemetry-label"/>
            <Label fx:id="footerStorageLabel" text="Kho lưu trữ: 0 tệp" styleClass="telemetry-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="serverClockLabel" text="GIỜ HỆ THỐNG: 00:00:00" styleClass="telemetry-label"/>
        </HBox>
    </bottom>
</BorderPane>
