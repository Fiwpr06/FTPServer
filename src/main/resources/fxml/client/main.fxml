<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncvault.client.controller.MainController"
            prefWidth="1080.0" prefHeight="700.0"
            stylesheets="@../../css/style.css">

    <!-- Thanh tiêu đề Telemetry phía trên -->
    <top>
        <HBox styleClass="hud-bar" spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="SYNCVAULT // TRÌNH QUẢN LÝ TỆP TIN PHÂN TÁN" styleClass="hud-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Máy chủ:" styleClass="telemetry-label"/>
            <Label fx:id="serverLabel" text="127.0.0.1:2121" styleClass="telemetry-value-nominal"/>

            <Label text="Tài khoản:" styleClass="telemetry-label"/>
            <Label fx:id="userLabel" text="student01" styleClass="telemetry-value-cyan"/>

            <Label fx:id="serverRolePill" text="PRIMARY (A)" styleClass="server-status-pill-running"/>

            <Button text="⏹ ĐĂNG XUẤT" onAction="#handleLogout" styleClass="button-danger"/>
        </HBox>
    </top>

    <!-- Khu vực duyệt file 2 cột đối xứng -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <SplitPane dividerPositions="0.48" VBox.vgrow="ALWAYS">
                <!-- Cột trái: Thư mục cục bộ (Local Computer) -->
                <VBox styleClass="terminal-panel" spacing="8">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="[ MÁY CỤC BỘ ]" styleClass="panel-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📂 DUYỆT THƯ MỤC" onAction="#handleBrowseLocalDir" styleClass="button"/>
                        <Button text="🔄 LÀM MỚI" onAction="#handleRefreshLocal" styleClass="button"/>
                    </HBox>
                    <Label fx:id="localPathLabel" text="C:/..." styleClass="telemetry-label"/>

                    <TableView fx:id="localTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colLocalName" text="TÊN TỆP TIN" prefWidth="240.0"/>
                            <TableColumn fx:id="colLocalSize" text="KÍCH THƯỚC" prefWidth="90.0"/>
                            <TableColumn fx:id="colLocalDate" text="NGÀY SỬA ĐỔI" prefWidth="130.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Button text=">> TẢI LÊN MÁY CHỦ (UPLOAD)" onAction="#handleUpload" styleClass="button-action"/>
                    </HBox>
                </VBox>

                <!-- Cột phải: Kho lưu trữ máy chủ FTP (Remote Server) -->
                <VBox styleClass="terminal-panel" spacing="8">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="[ KHO MÁY CHỦ TỪ XA ]" styleClass="panel-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📁 TẠO THƯ MỤC" onAction="#handleNewFolder" styleClass="button"/>
                        <Button text="🗑 XÓA TỆP" onAction="#handleDeleteRemote" styleClass="button-danger"/>
                        <Button text="🔄 LÀM MỚI" onAction="#handleRefreshRemote" styleClass="button"/>
                    </HBox>
                    <Label fx:id="remotePathLabel" text="/" styleClass="telemetry-label"/>

                    <TableView fx:id="remoteTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRemoteName" text="TÊN TỆP TIN" prefWidth="230.0"/>
                            <TableColumn fx:id="colRemoteSize" text="KÍCH THƯỚC" prefWidth="90.0"/>
                            <TableColumn fx:id="colRemotePerms" text="PHÂN QUYỀN" prefWidth="90.0"/>
                            <TableColumn fx:id="colRemoteDate" text="THỜI GIAN" prefWidth="100.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Button text="<< TẢI VỀ MÁY (DOWNLOAD)" onAction="#handleDownload" styleClass="button-action"/>
                    </HBox>
                </VBox>
            </SplitPane>

            <!-- Khung trạng thái truyền file & tiến trình -->
            <VBox styleClass="terminal-panel" spacing="6">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="TIẾN TRÌNH TRUYỀN DỮ LIỆU:" styleClass="telemetry-label"/>
                    <Label fx:id="transferStatusLabel" text="SẴN SÀNG" styleClass="telemetry-value-nominal"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="transferPercentLabel" text="0%" styleClass="telemetry-value-cyan"/>
                </HBox>
                <ProgressBar fx:id="transferProgressBar" progress="0.0" maxWidth="Infinity" prefHeight="16.0"/>
            </VBox>
        </VBox>
    </center>

    <!-- Thanh trạng thái chân trang -->
    <bottom>
        <HBox styleClass="hud-status-bar" spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <Label fx:id="footerStatusLabel" text="Đã kết nối giao thức FTP chuẩn RFC 959" styleClass="telemetry-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="SYNCVAULT CLUSTER 2026 // YORHA OS" styleClass="telemetry-label"/>
        </HBox>
    </bottom>
</BorderPane>
